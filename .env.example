API_URL=http://127.0.0.1:4000

# Grammatika manbasi (ADR-001): static (standart, build'dagi fayl) | release (PostgreSQL aktiv release, server ichki API orqali).
# release rejimida server bilan BIR XIL GRAMMAR_INTERNAL_TOKEN (>=16 belgi, maxfiy) kerak.
# GRAMMAR_SOURCE=static
# GRAMMAR_INTERNAL_TOKEN=
# GRAMMAR_API_URL=http://127.0.0.1:4000
# GRAMMAR_ACTIVE_TTL_MS=15000    # <=30000 (kill-switch kechikishi chegarasi)
# GRAMMAR_OVERLAY_TTL_MS=15000   # <=30000
# NEXT_DIST_DIR=.next-e2e        # faqat izolyatsiyalangan E2E build uchun

# Sayt manzili (canonical, sitemap, OG). Productionda: https://izlan.uz
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
